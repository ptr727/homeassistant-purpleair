#!/usr/bin/env bash
# Verify-only linter. Exits non-zero if anything is wrong — mirrors the CI
# workflow so "green locally" matches "green on GitHub". To apply
# auto-fixes run scripts/fix instead.

set -Eeuo pipefail

usage="Usage: scripts/lint [-h | --help]
Run ruff, mypy and pyright in verify-only mode, as CI does."
if (($# > 0)); then
    if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
        echo "$usage"
        exit 0
    fi
    echo "Unexpected arguments: $*" >&2
    echo "$usage" >&2
    exit 2
fi

cd "$(dirname "$0")/.."

# Activate the uv-managed .venv (created by scripts/setup) so ruff/mypy/pyright
# resolve no matter how this runs - terminal, VS Code task, or CI mirror.
if [[ ! -f .venv/bin/activate ]]; then
    echo "No .venv found - run scripts/setup first." >&2
    exit 1
fi
# shellcheck source=/dev/null
source .venv/bin/activate

ruff format . --check
ruff check .
# Platinum quality-scale rule "strict-typing" requires a clean strict run, configured by [tool.mypy] in pyproject.toml.
mypy
# Pyright is the CLI engine behind VS Code's Pylance extension; running it
# here ensures the in-editor and CI experience stay in sync. Configuration
# (scope, mode, enabled rules) lives in pyrightconfig.json so a single
# source of truth drives both surfaces.
pyright
