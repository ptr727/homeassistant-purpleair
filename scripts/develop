#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

# Activate the uv-managed .venv (created by scripts/setup) so `hass` resolves.
if [[ ! -f .venv/bin/activate ]]; then
    echo "No .venv found - run scripts/setup first." >&2
    exit 1
fi
# shellcheck source=/dev/null
source .venv/bin/activate

# Seed a minimal HA config if none exists (default_config pulls in heavy
# optional components not needed for integration dev; see scripts/init-config).
scripts/init-config

# Set the path to custom_components
## This lets us have the structure we want <root>/custom_components/purpleair
## while at the same time have Home Assistant configuration inside <root>/config
## without resulting to symlinks.
# `${PYTHONPATH:-}` keeps `set -u` happy when the variable is unset (default
# outside venvs).
export PYTHONPATH="${PYTHONPATH:-}:${PWD}/custom_components"

# Start Home Assistant.
# --skip-pip disables HA's runtime pip installs entirely. This preserves the
# editable ptr727-aiopurpleair install from scripts/setup (HA would otherwise
# reinstall the pinned version from PyPI, clobbering ./aiopurpleair), and stops
# HA from shelling out to pip for base-platform deps at launch -- those pip
# child processes make the VS Code debugger report "Server[N] disconnected".
# The frontend and the library are pre-installed by scripts/setup, so nothing
# the PurpleAir dev loop needs is missing.
hass --config "${PWD}/config" --debug --skip-pip
