#!/usr/bin/env bash
# Apply auto-fixes for ruff format + ruff check. Run scripts/lint afterwards
# to verify that anything ruff couldn't auto-fix is also clean.

set -Eeuo pipefail

usage="Usage: scripts/fix [-h | --help]
Apply ruff format and ruff check --fix. Run scripts/lint afterwards."
if (($# > 0)); then
    if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
        echo "$usage"
        exit 0
    fi
    echo "Unexpected arguments: $*" >&2
    echo "$usage" >&2
    exit 2
fi

cd "$(dirname "$0")/.."

# Activate the uv-managed .venv (created by scripts/setup) so ruff/mypy/pyright
# resolve no matter how this runs - terminal, VS Code task, or CI mirror.
if [[ ! -f .venv/bin/activate ]]; then
    echo "No .venv found - run scripts/setup first." >&2
    exit 1
fi
# shellcheck source=/dev/null
source .venv/bin/activate

ruff format .
ruff check . --fix
