{
    "folders": [
        {
            "name": "PurpleAir Integration",
            "path": "."
        },
        {
            "name": "aiopurpleair Library",
            "path": "./aiopurpleair"
        }
    ],
    "settings": {
        "editor.tabSize": 4,
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": false,
        "files.trimTrailingWhitespace": true,
        // Interpreter: the project's .venv virtual environment; activate it before
        // scripts/setup so its pip installs land there. The extension auto-detects .venv.
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.languageServer": "Pylance",
        // Pylance reads pyrightconfig.json (typeCheckingMode + rules); don't override it here.
        "python.analysis.extraPaths": ["./custom_components"],
        "python.analysis.autoImportCompletions": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["tests"],
        // Use the tools installed in the venv (matching the CLI versions + config)
        // rather than the extensions' bundled copies, so the editor and CLI agree.
        "ruff.importStrategy": "fromEnvironment",
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "mypy-type-checker.args": ["--strict", "--follow-imports=silent"],
        // Format and fix with ruff on save, matching `ruff format` + `ruff check --fix`.
        "[python]": {
            "editor.defaultFormatter": "charliermarsh.ruff",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                "source.fixAll.ruff": "explicit",
                "source.organizeImports.ruff": "explicit"
            }
        },
        "github.copilot.chat.commitMessageGeneration.instructions": [
            {
                "file": ".github/copilot-instructions.md"
            }
        ],
        "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
            {
                "file": ".github/copilot-instructions.md"
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "anthropic.claude-code",
            "arahata.linter-actionlint",
            "charliermarsh.ruff",
            "davidanson.vscode-markdownlint",
            "editorconfig.editorconfig",
            "github.vscode-pull-request-github",
            "ms-azuretools.vscode-docker",
            "ms-python.mypy-type-checker",
            "ms-python.python",
            "ms-python.vscode-pylance",
            "ms-vscode-remote.remote-containers",
            "openai.chatgpt",
            "redhat.vscode-xml",
            "redhat.vscode-yaml",
            "ryanluker.vscode-coverage-gutters",
            "streetsidesoftware.code-spell-checker",
            "timonwong.shellcheck"
        ]
    }
}
